#!/bin/sh
# Runs an AppImage without FUSE, which Android doesn't allow under PRoot: its SquashFS image is
# extracted once into ~/.cache/appimages (again only when the file changes), then AppRun starts
# from there. PCManFM opens .AppImage files with it, and libbox64exec sends every exec of an
# AppImage here, so running one from a terminal or a launcher works too.
set -e
[ $# -ge 1 ] || { echo "usage: tuxnator-run-appimage <file.AppImage> [args...]" >&2; exit 2; }
image=$(readlink -f "$1")
shift

# The SquashFS image starts right after the runtime ELF, which ends with its section headers
squashfs_offset() {
    if [ "$(od -An -t u1 -j 4 -N 1 "$1" | tr -d ' ')" = 2 ]; then
        shoff=$(od -An -t u8 -j 40 -N 8 "$1"); entsize=$(od -An -t u2 -j 58 -N 2 "$1"); count=$(od -An -t u2 -j 60 -N 2 "$1")
    else
        shoff=$(od -An -t u4 -j 32 -N 4 "$1"); entsize=$(od -An -t u2 -j 46 -N 2 "$1"); count=$(od -An -t u2 -j 48 -N 2 "$1")
    fi
    echo $((shoff + entsize * count))
}

name=$(basename "$image")
dir="${XDG_CACHE_HOME:-$HOME/.cache}/appimages/${name%.*}"
stamp="$image $(stat -c %s-%Y "$image")"
# Extracted from this very file, and complete (an AppRun or a nix-appimage entrypoint)
extracted() {
    [ "$(cat "$1/.tuxnator-stamp" 2>/dev/null)" = "$stamp" ] && { [ -e "$1/AppRun" ] || [ -L "$1/entrypoint" ]; }
}
if ! extracted "$dir"; then
    mkdir -p "$(dirname "$dir")"
    # The first extraction takes minutes with no window: a second double tap meanwhile used to
    # delete the half-written copy and leave one without AppRun. Now it just leaves.
    exec 9>"$dir.lock"
    flock -n 9 || exit 0
    if ! extracted "$dir"; then
        # A small terminal window says what is happening and closes when the extraction is done
        # (the X server has no core fonts for xmessage)
        notice="$(dirname "$dir")/.extracting-$$"
        : > "$notice"
        trap 'rm -f "$notice"' EXIT
        lxterminal --title=Tuxnator --geometry=64x4 -e "sh -c 'echo Preparando o AppImage para o primeiro uso.; echo Isso leva alguns minutos, e ele abre sozinho em seguida.; while [ -e $notice ]; do sleep 1; done'" >/dev/null 2>&1 &
        # Nix store directories come read-only, which rm can't empty
        chmod -R u+w "$dir" "$dir.tmp" 2>/dev/null || true
        rm -rf "$dir" "$dir.tmp"
        unsquashfs -q -n -no-xattrs -o "$(squashfs_offset "$image")" -d "$dir.tmp" "$image" >/dev/null
        echo "$stamp" > "$dir.tmp/.tuxnator-stamp"
        extracted "$dir.tmp" || { echo "$name: no AppRun after extracting it" >&2; exit 1; }
        mv "$dir.tmp" "$dir"
        rm -f "$notice"
        trap - EXIT
    fi
    exec 9>&-
fi

target="$dir/AppRun"
# Nix-bundled AppImages (nix-appimage) bind their /nix/store over /nix in a user namespace, which
# PRoot can't create: link the store paths into the guest's /nix/store and start the entrypoint
if [ -L "$dir/entrypoint" ] && [ -d "$dir/nix/store" ]; then
    mkdir -p /nix/store
    for path in "$dir"/nix/store/*; do
        link="/nix/store/${path##*/}"
        if [ -L "$link" ] || [ ! -e "$link" ]; then ln -sfn "$path" "$link"; fi
    done
    target="$dir/entrypoint"
    # Nix ships newer libraries than the rootfs (GLib, OpenSSL, expat...): Box64 must run the
    # bundled x86 ones rather than swap in native ones that lack their newer functions. It still
    # keeps libc, X11/xcb, GL/EGL, Vulkan and sound native, so drawing goes to the GPU.
    export BOX64_PREFER_EMULATED=1 BOX64_WRAP_EGL=1
fi

export APPIMAGE="$image" APPDIR="$dir" ARGV0="$image" OWD="$PWD"
# PRoot doesn't run #! scripts by itself, and AppRun is often one
read -r first < "$target" || true
case "$first" in
    "#!"*) exec ${first#\#!} "$target" "$@" ;;
    *) exec "$target" "$@" ;;
esac
