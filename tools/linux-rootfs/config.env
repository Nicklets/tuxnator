# Versions of everything that goes into the Linux runtime rootfs.
# Bump ROOTFS_VERSION whenever any of these change.
ROOTFS_VERSION=19
# testing: Nix-built and other recent x86 apps need a newer glibc than stable (Box64 forwards
# libc to the native one)
DEBIAN_SUITE=forky
DEBIAN_MIRROR=http://deb.debian.org/debian

BOX64_REPO=https://github.com/ptitSeb/box64.git
# A main commit: wraps the libc functions added in glibc 2.43 (free_sized...), which v0.4.4 lacks,
# and has our two fixes upstream (geted FS:-disp base register, ptitSeb/box64#4645; write faults
# in wrapped native functions, #4644). SacredFire/CTR was verified on 6dfbebd with those patches.
BOX64_REF=e86a766cbe1e147fd90ff8248e2bf9beb007ff8e
# BAD_SIGNAL works around Android kernels reporting incoherent si_info on SIGSEGV
BOX64_CMAKE_FLAGS="-DARM_DYNAREC=ON -DBAD_SIGNAL=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo"

MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_REF=mesa-26.2.5
# Turnip on the Android KGSL kernel driver + Zink for OpenGL. Debian's Mesa has no KGSL backend.
# msm is listed only so Mesa links libdrm: with kgsl alone it builds the X11 WSI's DRI3 path
# (HAVE_X11_DRM) without the DRM image code it needs (HAVE_LIBDRM), and every non-sw swapchain
# crashes. Turnip still enumerates KGSL first; there is no /dev/dri on Android.
# debugoptimized = -O2 with debug info; build-components.sh splits the debug info into a separate
# package for gdb, so the rootfs itself doesn't grow.
MESA_MESON_FLAGS="-Dbuildtype=debugoptimized -Db_ndebug=true -Dstrip=false \
 -Dplatforms=x11 -Dvulkan-drivers=freedreno -Dfreedreno-kmds=kgsl,msm \
 -Dgallium-drivers=zink -Dglx=dri -Degl=enabled -Dgles1=disabled -Dgles2=enabled \
 -Dglvnd=enabled -Dxlib-lease=disabled -Dllvm=disabled -Dvalgrind=disabled -Dlibunwind=disabled"
